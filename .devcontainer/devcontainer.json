{
  "name": "Claude Code Sandbox (uv + rust + node/pnpm + jj)",
  "build": {
    "dockerfile": "Containerfile",
    "args": {
      "TZ": "${localEnv:TZ:Australia/Melbourne}",
      "GIT_DELTA_VERSION": "0.18.2"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "dbaeumer.vscode-eslint",
        "rust-lang.rust-analyzer",
        "ms-python.python",
        "charliermarsh.ruff",
        "jjk.jjk",
        "biomejs.biome"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "biomejs.biome",
        "editor.codeActionsOnSave": {
          "source.fixAll.eslint": "explicit"
        },
        "terminal.integrated.defaultProfile.linux": "bash",
        "terminal.integrated.profiles.linux": {
          "bash": {
            "path": "bash",
            "icon": "terminal-bash"
          }
        },
        "git.enabled": false
      }
    }
  },
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {
      "version": "latest"
    }
  },
  "remoteUser": "node",
  "mounts": [
    "source=claude-code-bashhistory-${devcontainerId},target=/commandhistory,type=volume",
    "source=claude-code-config-${devcontainerId},target=/home/node/.claude,type=volume"
  ],
  "containerEnv": {
    "NODE_OPTIONS": "--max-old-space-size=4096",
    "CLAUDE_CONFIG_DIR": "/home/node/.claude"
  },
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=delegated",
  "workspaceFolder": "/workspace",
  "postCreateCommand": "(test -d .jj || jj git init --no-colocate) && jj config set --user user.email \"18359644+stevenhuyn@users.noreply.github.com\" && jj config set --user user.name \"stevenhuyn\" && jj bookmark set main -r @"
}
