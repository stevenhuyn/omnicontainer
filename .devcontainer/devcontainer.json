{
    "name": "dev",
    "build": { "dockerfile": "Containerfile" },

    "features": {
        "ghcr.io/devcontainers/features/rust:1": {
            "version": "latest",
            "profile": "default"
        },
        "ghcr.io/devcontainers/features/node:1": {
            "version": "lts",
            "pnpmVersion": "latest"
        }
    },

    // jj is installed via cargo so it picks up the Rust toolchain from the feature.
    // --locked respects jj's Cargo.lock for reproducible builds.
    "postCreateCommand": "cargo install --locked --bin jj jj-cli"
}
